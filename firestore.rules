rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email in ['sanskarpatil838@gmail.com'];
    }

    function validRecordingStatus(status) {
      return status in ['recording', 'completed', 'failed'];
    }

    function validChunkStatus(status) {
      return status in ['uploaded', 'failed'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if false;
      allow delete: if false;

      match /attempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if false;
        allow update, delete: if false;
      }

      match /pointsHistory/{historyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /{path=**}/attempts/{attemptId} {
      allow read: if isAdmin();
    }

    match /withdrawalRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /referrals/{referralId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.referrerUserId == request.auth.uid
            || resource.data.referredUserId == request.auth.uid
          )
        );
      allow create, update, delete: if false;
    }

    match /recordings/{attemptId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.attemptId == attemptId
        && request.resource.data.quizId is string
        && validRecordingStatus(request.resource.data.status)
        && request.resource.data.finalVideoUrl == null;

      allow update: if signedIn()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.quizId == resource.data.quizId
        && request.resource.data.attemptId == resource.data.attemptId
        && request.resource.data.finalVideoUrl == resource.data.finalVideoUrl
        && request.resource.data.finalVideoPath == resource.data.finalVideoPath
        && validRecordingStatus(request.resource.data.status);

      allow delete: if false;

      match /chunks/{chunkId} {
        allow read: if isAdmin()
          || (
            signedIn()
            && get(/databases/$(database)/documents/recordings/$(attemptId)).data.studentId == request.auth.uid
          );

        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/recordings/$(attemptId)).data.studentId == request.auth.uid
          && request.resource.data.index is int
          && validChunkStatus(request.resource.data.status);

        allow delete: if false;
      }
    }
  }
}
